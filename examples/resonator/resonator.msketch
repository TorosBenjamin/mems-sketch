format: mems-sketch/2
name: resonator
top: top
libraries: {mems: bundled@3, std: bundled@2}
process: mems.surface
overrides:
  rules:
    device_anchored:
      enabled: false
      reason: the drawing does not model its anchors or the etch
    device_release:
      enabled: false
      reason: the drawing does not model its anchors or the etch
components: {top: components/top, suspension: components/suspension}
